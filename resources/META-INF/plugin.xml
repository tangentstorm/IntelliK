<idea-plugin version="2">
  <id>com.x1010data.intellik</id>
  <name>K Language</name>
  <version>1.0</version>
  <vendor url="https://github.com/tangentstorm/IntelliK">Michal Wallace</vendor>

  <description><![CDATA[
        Support for the K family of array languages: syntax highlighting,
        parsing, structure view and completion of built-in primitives.
        <p>The plugin is being built out to support several K dialects
        (k3, q/k4, Kona, ngn/k, oK, K#, k9) from one shared lexer and
        per-dialect primitive tables. Today, K3 is the supported dialect.</p>
    ]]></description>

  <change-notes><![CDATA[
        Initial version.
    ]]>
  </change-notes>

  <!-- since-build/until-build are set by the Gradle build (see build.gradle.kts). -->

  <!-- please see http://www.jetbrains.org/intellij/sdk/docs/basics/getting_started/plugin_compatibility.html
       on how to target different products -->
  <depends>com.intellij.modules.lang</depends>

  <extensions defaultExtensionNs="com.intellij">
      <fileType name="K Language Source File" language="K" extensions="k"
                implementationClass="com.x1010data.intellik.KFileType" fieldName="INSTANCE"/>
      <lang.parserDefinition language="K" implementationClass="com.x1010data.intellik.KParserDefinition"/>
      <lang.syntaxHighlighterFactory key="K" language="K"
                                     implementationClass="com.x1010data.intellik.KSyntaxHighlighterFactory"/>
      <colorSettingsPage implementation="com.x1010data.intellik.KColorSettingsPage"/>
      <completion.contributor language="K" implementationClass="com.x1010data.intellik.KCompletionContributor"/>
      <lang.psiStructureViewFactory language="K" implementationClass="com.x1010data.intellik.KStructureViewFactory"/> 
  </extensions>

</idea-plugin>
